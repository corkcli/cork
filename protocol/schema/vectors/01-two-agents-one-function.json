{
  "name": "Two agents edit one function and resolve in milliseconds",
  "description": "Alice and Bob both change parse_config's body from version 0. Alice lands first; Bob is rejected at once with her op and her intent, merges locally, and lands on version 1.",
  "steps": [
    {
      "at": 0,
      "conn": "alice",
      "send": {
        "t": "hello",
        "proto": 1,
        "session": "alice-1",
        "agent_id": "claude-a",
        "person": "alice@example.com",
        "scope": "acme/api"
      },
      "expect": [
        {
          "conn": "alice",
          "recv": {
            "t": "welcome",
            "proto": 1,
            "session": "alice-1",
            "resumed": false,
            "resumed_leases": []
          }
        }
      ]
    },
    {
      "at": 0,
      "conn": "bob",
      "send": {
        "t": "hello",
        "proto": 1,
        "session": "bob-1",
        "agent_id": "codex-b",
        "person": "bob@example.com",
        "scope": "acme/api"
      },
      "expect": [
        {
          "conn": "bob",
          "recv": {
            "t": "welcome",
            "proto": 1,
            "session": "bob-1",
            "resumed": false,
            "resumed_leases": []
          }
        }
      ]
    },
    {
      "at": 0,
      "conn": "alice",
      "send": {
        "t": "subscribe",
        "keys": [
          "code:src/cli.py::parse_config"
        ],
        "depth": 0
      },
      "expect": []
    },
    {
      "at": 0,
      "conn": "bob",
      "send": {
        "t": "subscribe",
        "keys": [
          "code:src/cli.py::parse_config"
        ],
        "depth": 0
      },
      "expect": []
    },
    {
      "at": 10,
      "conn": "alice",
      "send": {
        "t": "op",
        "op_id": "alice-1.1",
        "key": "code:src/cli.py::parse_config",
        "base": {
          "version": 0,
          "hash": ""
        },
        "kind": "modify_body",
        "payload": "ZGlmZi1h",
        "intent_id": "tighten-validation",
        "hlc": {
          "w": 10,
          "c": 0
        }
      },
      "expect": [
        {
          "conn": "alice",
          "recv": {
            "t": "ack",
            "op_id": "alice-1.1",
            "key": "code:src/cli.py::parse_config",
            "version": 1,
            "hash": "$bind:h1",
            "seq": 1
          }
        },
        {
          "conn": "bob",
          "recv": {
            "t": "delta",
            "op": {
              "op_id": "alice-1.1",
              "key": "code:src/cli.py::parse_config",
              "kind": "modify_body",
              "author": {
                "session": "alice-1",
                "person": "alice@example.com"
              }
            },
            "version": 1,
            "hash": "$ref:h1",
            "layer": "draft"
          }
        }
      ]
    },
    {
      "at": 12,
      "conn": "bob",
      "send": {
        "t": "op",
        "op_id": "bob-1.1",
        "key": "code:src/cli.py::parse_config",
        "base": {
          "version": 0,
          "hash": ""
        },
        "kind": "modify_body",
        "payload": "ZGlmZi1i",
        "intent_id": "retry-on-timeout",
        "hlc": {
          "w": 12,
          "c": 0
        }
      },
      "expect": [
        {
          "conn": "bob",
          "recv": {
            "t": "reject",
            "op_id": "bob-1.1",
            "key": "code:src/cli.py::parse_config",
            "reason": "conflict",
            "current": {
              "version": 1,
              "hash": "$ref:h1"
            },
            "theirs": [
              {
                "op_id": "alice-1.1",
                "kind": "modify_body",
                "version": 1,
                "payload": "ZGlmZi1h",
                "author": {
                  "agent_id": "claude-a"
                }
              }
            ],
            "their_intent": {
              "id": "tighten-validation"
            },
            "holder": {
              "session": "alice-1"
            }
          }
        }
      ]
    },
    {
      "at": 19,
      "conn": "bob",
      "send": {
        "t": "op",
        "op_id": "bob-1.2",
        "key": "code:src/cli.py::parse_config",
        "base": {
          "version": 1,
          "hash": "$ref:h1"
        },
        "kind": "modify_body",
        "payload": "bWVyZ2Vk",
        "intent_id": "retry-on-timeout",
        "hlc": {
          "w": 19,
          "c": 0
        }
      },
      "expect": [
        {
          "conn": "bob",
          "recv": {
            "t": "ack",
            "op_id": "bob-1.2",
            "version": 2,
            "seq": 2
          }
        },
        {
          "conn": "alice",
          "recv": {
            "t": "delta",
            "op": {
              "op_id": "bob-1.2",
              "author": {
                "person": "bob@example.com"
              }
            },
            "version": 2,
            "layer": "draft"
          }
        }
      ]
    },
    {
      "at": 20,
      "conn": "bob",
      "send": {
        "t": "message",
        "anchor": "code:src/cli.py::parse_config",
        "text": "merged your validation into my retry change; please re-run the CLI tests"
      },
      "expect": [
        {
          "conn": "alice",
          "recv": {
            "t": "message",
            "from": {
              "session": "bob-1",
              "person": "bob@example.com"
            },
            "anchor": "code:src/cli.py::parse_config",
            "text": "merged your validation into my retry change; please re-run the CLI tests"
          }
        }
      ]
    }
  ]
}
