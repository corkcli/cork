{
  "name": "Tasks: two agents claim one task",
  "description": "claim x claim = conflict. Alice and Bob both try to take task:eng-42 from version 0; Bob is told at once that Alice holds it. A comment from the same stale base commutes and lands.",
  "steps": [
    {
      "at": 0,
      "conn": "alice",
      "send": {
        "t": "hello",
        "proto": 1,
        "session": "alice-1",
        "agent_id": "claude-a",
        "person": "alice@example.com",
        "scope": "acme/api"
      },
      "expect": [
        {
          "conn": "alice",
          "recv": {
            "t": "welcome",
            "proto": 1,
            "session": "alice-1",
            "resumed": false,
            "resumed_leases": []
          }
        }
      ]
    },
    {
      "at": 0,
      "conn": "bob",
      "send": {
        "t": "hello",
        "proto": 1,
        "session": "bob-1",
        "agent_id": "codex-b",
        "person": "bob@example.com",
        "scope": "acme/api"
      },
      "expect": [
        {
          "conn": "bob",
          "recv": {
            "t": "welcome",
            "proto": 1,
            "session": "bob-1",
            "resumed": false,
            "resumed_leases": []
          }
        }
      ]
    },
    {
      "at": 1,
      "conn": "alice",
      "send": {
        "t": "op",
        "op_id": "alice-1.1",
        "key": "task:eng-42",
        "base": {
          "version": 0,
          "hash": ""
        },
        "kind": "claim",
        "hlc": {
          "w": 1,
          "c": 0
        }
      },
      "expect": [
        {
          "conn": "alice",
          "recv": {
            "t": "ack",
            "key": "task:eng-42",
            "version": 1
          }
        }
      ]
    },
    {
      "at": 1,
      "conn": "bob",
      "send": {
        "t": "op",
        "op_id": "bob-1.1",
        "key": "task:eng-42",
        "base": {
          "version": 0,
          "hash": ""
        },
        "kind": "claim",
        "hlc": {
          "w": 1,
          "c": 0
        }
      },
      "expect": [
        {
          "conn": "bob",
          "recv": {
            "t": "reject",
            "reason": "conflict",
            "key": "task:eng-42",
            "theirs": [
              {
                "op_id": "alice-1.1",
                "kind": "claim"
              }
            ],
            "holder": {
              "person": "alice@example.com"
            }
          }
        }
      ]
    },
    {
      "at": 2,
      "conn": "bob",
      "send": {
        "t": "op",
        "op_id": "bob-1.2",
        "key": "task:eng-42",
        "base": {
          "version": 0,
          "hash": ""
        },
        "kind": "comment",
        "hlc": {
          "w": 2,
          "c": 0
        }
      },
      "expect": [
        {
          "conn": "bob",
          "recv": {
            "t": "ack",
            "version": 2,
            "rebased_over": [
              {
                "op_id": "alice-1.1",
                "kind": "claim"
              }
            ]
          }
        }
      ]
    }
  ]
}
