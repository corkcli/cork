{
  "name": "The gate asks first; a tested push promotes",
  "description": "Bob's check says a body edit from version 0 would conflict with Alice's draft. Alice's tests pass and she promotes her op: subscribers see it again in the promoted layer.",
  "steps": [
    {
      "at": 0,
      "conn": "alice",
      "send": {
        "t": "hello",
        "proto": 1,
        "session": "alice-1",
        "agent_id": "claude-a",
        "person": "alice@example.com",
        "scope": "acme/api"
      },
      "expect": [
        {
          "conn": "alice",
          "recv": {
            "t": "welcome",
            "proto": 1,
            "session": "alice-1",
            "resumed": false,
            "resumed_leases": []
          }
        }
      ]
    },
    {
      "at": 0,
      "conn": "bob",
      "send": {
        "t": "hello",
        "proto": 1,
        "session": "bob-1",
        "agent_id": "codex-b",
        "person": "bob@example.com",
        "scope": "acme/api"
      },
      "expect": [
        {
          "conn": "bob",
          "recv": {
            "t": "welcome",
            "proto": 1,
            "session": "bob-1",
            "resumed": false,
            "resumed_leases": []
          }
        }
      ]
    },
    {
      "at": 0,
      "conn": "bob",
      "send": {
        "t": "subscribe",
        "keys": [
          "code:src/cli.py::parse_config"
        ],
        "depth": 0
      },
      "expect": []
    },
    {
      "at": 1,
      "conn": "alice",
      "send": {
        "t": "op",
        "op_id": "alice-1.1",
        "key": "code:src/cli.py::parse_config",
        "base": {
          "version": 0,
          "hash": ""
        },
        "kind": "modify_body",
        "hlc": {
          "w": 1,
          "c": 0
        }
      },
      "expect": [
        {
          "conn": "alice",
          "recv": {
            "t": "ack",
            "version": 1
          }
        },
        {
          "conn": "bob",
          "recv": {
            "t": "delta",
            "layer": "draft"
          }
        }
      ]
    },
    {
      "at": 2,
      "conn": "bob",
      "send": {
        "t": "check",
        "req": "q1",
        "keys": [
          {
            "key": "code:src/cli.py::parse_config",
            "base": {
              "version": 0,
              "hash": ""
            },
            "kind": "modify_body"
          },
          {
            "key": "code:src/cli.py::parse_config",
            "base": {
              "version": 0,
              "hash": ""
            },
            "kind": "rename"
          }
        ]
      },
      "expect": [
        {
          "conn": "bob",
          "recv": {
            "t": "check_result",
            "req": "q1",
            "results": [
              {
                "key": "code:src/cli.py::parse_config",
                "status": "stale",
                "would": "conflict",
                "current": {
                  "version": 1,
                  "promoted_version": 0
                },
                "theirs": [
                  {
                    "op_id": "alice-1.1"
                  }
                ]
              },
              {
                "key": "code:src/cli.py::parse_config",
                "status": "stale",
                "would": "rebase"
              }
            ]
          }
        }
      ]
    },
    {
      "at": 30,
      "conn": "alice",
      "send": {
        "t": "promote",
        "req": "p1",
        "op_ids": [
          "alice-1.1"
        ],
        "evidence": {
          "tests": "passed",
          "commit": "9f2c1ab"
        }
      },
      "expect": [
        {
          "conn": "bob",
          "recv": {
            "t": "delta",
            "op": {
              "op_id": "alice-1.1"
            },
            "layer": "promoted"
          }
        },
        {
          "conn": "alice",
          "recv": {
            "t": "promoted",
            "req": "p1",
            "op_ids": [
              "alice-1.1"
            ],
            "keys": [
              {
                "key": "code:src/cli.py::parse_config",
                "promoted_version": 1
              }
            ]
          }
        }
      ]
    }
  ]
}
